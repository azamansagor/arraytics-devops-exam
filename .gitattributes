# Shell scripts and configs are written on Windows but executed on Linux.
# Force LF so bash does not fail with "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
Dockerfile* text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
